# Copy this file to .env.local and fill in values from your Meta developer account.
# Leave empty to run the app in demo mode (fake AI answers).
META_API_KEY=
# OpenAI-compatible endpoint from Meta's docs (ends before /chat/completions)
META_API_BASE_URL=https://api.meta.ai/v1
# Model id from https://ai.developer.meta.com/docs/models/
META_MODEL=muse-spark-1.2

# ---- Backend (accounts, saved progress, shared posts/jobs/messages) ----
# MongoDB connection string, e.g. from MongoDB Atlas (free tier works). Leave empty in local dev to use .data/dev-db.json.
MONGODB_URI=
MONGODB_DB=careerforge
# Long random string that signs login cookies. REQUIRED in production (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=
